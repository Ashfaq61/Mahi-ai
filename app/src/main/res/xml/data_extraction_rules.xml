<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mahi_secure_api_keys.xml" />
        <exclude domain="sharedpref" path="mahi_preferences_store.xml" />
        <exclude domain="file" path="user_memory.json" />
        <exclude domain="file" path="app_label_memory.json" />
        <exclude domain="database" path="mahi_ai_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mahi_secure_api_keys.xml" />
    </device-transfer>
</data-extraction-rules>
